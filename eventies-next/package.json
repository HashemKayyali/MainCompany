{
  "name": "eventies-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --check src scripts",
    "format:fix": "prettier --write src scripts",
    "gate:arch": "node scripts/check-arch-gates.mjs",
    "gate:i18n": "node scripts/check-i18n-coverage.mjs",
    "gate:cycles": "madge --circular --extensions ts,tsx src",
    "ci": "npm run typecheck && npm run lint && npm run gate:arch && npm run gate:i18n && npm run gate:cycles && npm run test && npm run build"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.76",
    "@sentry/nextjs": "^10.65.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "cookie": "^1.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.575.0",
    "next": "16.2.10",
    "next-intl": "^4.13.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^29.1.1",
    "madge": "^8.0.0",
    "postcss": "^8.5.16",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
