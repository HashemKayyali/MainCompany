# Supabase project credentials (required)
# Get these from your Supabase project dashboard: Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Identity Services client ID (frontend-safe).
# Do NOT add a Google Client Secret to frontend env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Social login uses Google Identity Services in the browser and exchanges the
# returned ID token with Supabase Auth via signInWithIdToken.
#
# Required provider dashboard setup:
# - Google:   https://supabase.com/docs/guides/auth/social-login/auth-google
# - Facebook: https://supabase.com/docs/guides/auth/social-login/auth-facebook
# - Apple:    https://supabase.com/docs/guides/auth/social-login/auth-apple
#
# Google Cloud Authorized JavaScript origins:
#   https://www.eventiesjo.com
#   https://eventiesjo.com
