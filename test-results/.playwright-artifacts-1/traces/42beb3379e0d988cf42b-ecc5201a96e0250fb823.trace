{"type":"frame-snapshot","snapshot":{"callId":"call@55","snapshotName":"before@call@55","pageId":"page@fc8aba27a642d8152d086329128e6f18","frameId":"frame@ef376e12f42da8ab73b1922fddf8afab","frameUrl":"http://127.0.0.1:4174/","doctype":"html","html":["HTML",{"lang":"en","class":"light","dir":"ltr","data-locale":"en","style":"--app-visual-viewport-height: 800px; --app-visual-viewport-width: 375px; --app-visual-viewport-offset-top: 0px; --app-visual-viewport-offset-left: 0px; --app-visual-viewport-scale: 1; color-scheme: light;"},["HEAD",{},["BASE",{"href":"http://127.0.0.1:4174/"}],"\n  ","\n\n  ","\n\n  ",["META",{"charset":"utf-8"}],"\n  ",["META",{"name":"viewport","content":"width=device-width, initial-scale=1.0, viewport-fit=cover"}],"\n  ",["LINK",{"rel":"icon","href":"/favicon.ico","sizes":"any"}],"\n  ",["LINK",{"rel":"icon","type":"image/png","sizes":"48x48","href":"/favicon-48x48.png"}],"\n  ",["LINK",{"rel":"icon","type":"image/png","sizes":"32x32","href":"/favicon-32x32.png"}],"\n  ",["LINK",{"rel":"icon","type":"image/png","sizes":"16x16","href":"/favicon-16x16.png"}],"\n  ",["LINK",{"rel":"apple-touch-icon","href":"/apple-touch-icon.png"}],"\n  ",["TITLE",{},"Eventies | Event Services Marketplace in Jordan"],"\n  ",["META",{"name":"description","content":"Explore event rentals, interactive activations, screens, booths, production support, and custom setups across Jordan, then submit a rental or purchase quote request for review."}],"\n  ",["META",{"name":"theme-color","content":"#7c3aed"}],"\n  ",["META",{"property":"og:title","content":"Eventies | Event Services Marketplace in Jordan"}],"\n  ",["META",{"property":"og:description","content":"Explore event rentals, interactive activations, screens, booths, production support, and custom setups across Jordan, then submit a rental or purchase quote request for review."}],"\n  ",["META",{"property":"og:url","content":"https://www.eventiesjo.com/"}],"\n  ",["META",{"property":"og:type","content":"website"}],"\