{"type":"before","callId":"call@148","startTime":371843.929,"class":"Route","method":"fulfill","params":{"status":200,"headers":[{"name":"access-control-allow-origin","value":"*"},{"name":"access-control-expose-headers","value":"*"},{"name":"content-type","value":"application/json"},{"name":"content-length","value":"6259"}],"body":"[{\"id\":\"product-1\",\"title\":\"Bike Blender\",\"slug\":\"bike-blender\",\"description\":\"An interactive healthy experience where participants make their own fresh smoothies by pedaling. The faster you pedal, the faster it blends!\",\"price\":250,\"category_id\":\"cat-bikeland\",\"is_active\":true,\"badge\":\"Most Popular\",\"badge_color\":\"from-amber-400 to-orange-500\",\"category_tags\":[\"Interactive\",\"Wellness\"],\"short_description\":\"Pedal-powered smoothie station. Ride the bike, blend your own fresh drink live.\",\"featured\":true,\"hero_image\":\"/assets/products/bike-blender/hero.webp\",\"gallery\":[\"/assets/products/bike-blender/hero.webp\"],\"quick_options\":[{\"label\":\"Bikes\",\"values\":[\"1\",\"2\",\"3\",\"4\"]}],\"notes\":[\"Requires fresh ingredients\",\"Needs 1x power outlet per bike\",\"Setup: ~30 min\"],\"features_left\":[\"Real blending by cycling\",\"Fresh healthy smoothies\",\"Branded booth & cups\"],\"features_right\":[\"On-site staff included\",\"Perfect for wellness events\",\"Hygiene-first prep\"],\"currency\":\"JOD\",\"show_price\":true,\"video_url\":null,\"rental_enabled\":true,\"sale_enabled\":true,\"stock_total\":4,\"stock_active\":0,\"minimum_rental_days\":1,\"buffer_before_days\":0,\"buffer_after_days\":0,\"created_at\":\"2026-07-10T12:00:00.000Z\"},{\"id\":\"product-2\",\"title\":\"Bike Tower\",\"slug\":\"bike-tower\",\"description\":\"A thrilling two-player race! Each rider powers up their LED Tower. First to the top wins.\",\"price\":350,\"category_id\":\"cat-bikeland\",\"is_active\":true,\"badge\":\"Competitive\",\"badge_color\":\"from-prism-cyan to-blue-500\",\"category_tags\":[\"Competitive\",\"LED\"],\"short_description\":\"Two-player LED tower race. Pedal to light up your tower first.\",\"featured\":true,\"hero_image\":\"/assets/products/bike-tower/hero.webp\",\"gallery\":[\"/assets/products/bike-tower/hero.webp\"],\"quick_options\":[{\"label\":\"Bikes\",\"values\":[\"2\"]}],\"notes\":[\"Works in bright venues\",\"Requires 1x outlet\",\"Setup: ~45 min\"],\"features_left\":[\"Head-to-head competition\",\"Custom LED columns\",\"Fast setup\"],\"features_right\":[\"3 difficulty levels\",\"High impact\",\"Real-time progress\"],\"currency\":\"JOD\",\"show_price\":true,\"video_url\":null,\"rental_enabled\":true,\"sale_enabled\":true,\"stock_total\":4,\"stock_active\":0,\"minimum_rental_days\":1,\"buffer_before_days\":0,\"buffer_after_days\":0,\"created_at\":\"2026-07-10T12:00:00.000Z\"},{\"id\":\"product-3\",\"title\":\"Bike VR\",\"slug\":\"bike-vr\",\"description\":\"Immersive VR cycling combining exercise with digital adventure. Resistance syncs with the virtual world.\",\"price\":400,\"category_id\":\"cat-terminal-vr\",\"is_active\":true,\"badge\":\"Immersive\",\"badge_color\":\"from-prism-pink to-rose-500\",\"category_tags\":[\"Immersive\",\"VR\"],\"short_description\":\"VR cycling through stunning digital worlds.\",\"featured\":true,\"hero_image\":\"/assets/products/bike-vr/hero.webp\",\"gallery\":[\"/assets/products/bike-vr/hero.webp\"],\"quick_options\":[{\"label\":\"Bikes\",\"values\":[\"1\",\"2\"]}],\"notes\":[\"Requires 2x outlets\",\"Age 10+\",\"Staff provided\"],\"features_left\":[\"Full VR immersion\",\"Multiple environments\",\"Synced resistance\"],\"features_right\":[\"Professionally supervised\",\"Perfect for tech events\",\"Unforgettable experience\"],\"currency\":\"JOD\",\"show_price\":true,\"video_url\":null,\"rental_enabled\":true,\"sale_enabled\":true,\"stock_total\":4,\"stock_active\":0,\"minimum_rental_days\":1,\"buffer_before_days\":0,\"buffer_after_days\":0,\"created_at\":\"2026-07-10T12:00:00.000Z\"},{\"id\":\"product-4\",\"title\":\"Bike Race\",\"slug\":\"bike-race\",\"description\":\"Energetic cycling game with live stats on-screen. Perfect for exhibitions and fitness events.\",\"price\":300,\"category_id\":\"cat-bikeland\",\"is_active\":true,\"badge\":\"Racing\",\"badge_color\":\"from-rose-400 to-red-500\",\"category_tags\":[\"Competitive\",\"Fitness\"],\"short_description\":\"Live cycling race with real-time stats on screen.\",\"featured\":false,\"hero_image\":\"/assets/products/bike-race/hero.webp\",\"gallery\":[\"/assets/products/bike-race/hero.webp\"],\"quick_options\":[{\"label\":\"Screen\",\"values\":[\"32\\\"\",\"55\\\"\"]}],\"notes\":[\"1x outlet + screen\",\"Indoor/outdoor\",\"Setup: ~30 min\"],\"features_left\":[\"Live speed tracking\",\"On-screen stats\"],\"features_right\":[\"Great for fitness events\",\"Easy setup\"],\"currency\":\"JOD\",\"show_price\":true,\"video_url\":null,\"rental_enabled\":true,\"sale_enabled\":true,\"stock_total\":4,\"stock_active\":0,\"minimum_rental_days\":1,\"buffer_before_days\":0,\"buffer_after_days\":0,\"created_at\":\"2026-07-10T12:00:00.000Z\"},{\"id\":\"product-5\",\"title\":\"Bike Branding\",\"slug\":\"bike-branding\",\"description\":\"Transform any product into a fully branded experience with custom wraps, booths, and cups.\",\"price\":150,\"category_id\":\"cat-bikeland\",\"is_active\":true,\"badge\":\"Custom\",\"badge_color\":\"from-teal-400 to-violet-500\",\"category_tags\":[\"Branding\"],\"short_description\":\"Fully branded cycling experience.\",\"featured\":false,\"hero_image\":\"/assets/products/bike-branding/hero.webp\",\"gallery\":[\"/assets/products/bike-branding/hero.webp\"],\"quick_options\":[{\"label\":\"Level\",\"values\":[\"Basic\",\"Full\",\"Premium\"]}],\"notes\":[\"Brand assets 5 days before\",\"Design mockup provided\"],\"features_left\":[\"Full wrapping\",\"Custom LED\"],\"features_right\":[\"Design approval\",\"Pro print\"],\"currency\":\"JOD\",\"show_price\":true,\"video_url\":null,\"rental_enabled\":true,\"sale_enabled\":true,\"stock_total\":4,\"stock_active\":0,\"minimum_rental_days\":1,\"buffer_before_days\":0,\"buffer_after_days\":0,\"created_at\":\"2026-07-10T12:00:00.000Z\"},{\"id\":\"product-6\",\"title\":\"Bike Beam\",\"slug\":\"bike-beam\",\"description\":\"Spectacular LED beam powered by cycling. Best in dimly lit or nighttime venues.\",\"price\":300,\"category_id\":\"cat-bikeland\",\"is_active\":true,\"badge\":\"LED Show\",\"badge_color\":\"from-amber-400 to-yellow-500\",\"category_tags\":[\"LED\",\"Show\"],\"short_description\":\"Pedal-powered LED beam. Harder you ride, brighter the show.\",\"featured\":false,\"hero_image\":\"/assets/products/bike-beam/hero.webp\",\"gallery\":[\"/assets/products/bike-beam/hero.webp\"],\"quick_options\":[{\"label\":\"Beam\",\"values\":[\"Medium\",\"Large\"]}],\"notes\":[\"Best in dim venues\",\"1x outlet\",\"Setup: ~45 min\"],\"features_left\":[\"Stunning LED display\",\"Pedal-powered intensity\"],\"features_right\":[\"Multiple color modes\",\"Instagram-worthy\"],\"currency\":\"JOD\",\"show_price\":true,\"video_url\":null,\"rental_enabled\":true,\"sale_enabled\":true,\"stock_total\":4,\"stock_active\":0,\"minimum_rental_days\":1,\"buffer_before_days\":0,\"buffer_after_days\":0,\"created_at\":\"2026-07-10T12:00:00.000Z\"}]","isBase64":false},"stepId":"pw:api@109","pageId":"page@fc8aba27a642d8152d086329128e6f18"}
