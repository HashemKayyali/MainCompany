-50px_rgba(89,23,196,0.35)] sm:p-7"},["H2",{"class":"text-xl font-black tracking-[-0.025em] text-ink-950 sm:text-2xl"},"2. Information we collect"],["DIV",{"class":"mt-4 space-y-3 text-[14px] leading-8 text-ink-700/82 sm:text-[15px] sm:leading-8"},["P",{},["SPAN",{},"Depending on how you use Eventies, we may collect the following information:"]]],["UL",{"class":"mt-4 space-y-3 text-[14px] leading-8 text-ink-700/82 sm:text-[15px] sm:leading-8"},["LI",{"class":"flex gap-3"},["SPAN",{"class":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500","aria-hidden":"true"}],["SPAN",{},["SPAN",{},"Name and contact details, including email address and phone number."]]],["LI",{"class":"flex gap-3"},["SPAN",{"class":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500","aria-hidden":"true"}],["SPAN",{},["SPAN",{},"Account details, profile information, and profile image if you choose to add one."]]],["LI",{"class":"flex gap-3"},["SPAN",{"class":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500","aria-hidden":"true"}],["SPAN",{},["SPAN",{},"City, address, event location, venue details, and delivery/setup notes."]]],["LI",{"class":"flex gap-3"},["SPAN",{"class":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500","aria-hidden":"true"}],["SPAN",{},["SPAN",{},"Request details such as event date, services requested, quantities, notes, status, and request history."]]],["LI",{"class":"flex gap-3"},["SPAN",{"class":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500","aria-hidden":"true"}],["SPAN",{},["SPAN",{},"Vendor-related content, including product/service images, descriptions, categories, availability, and listing details when vendors provide them to Eventies."]]],["LI",{"class":"flex gap-3"},["SPAN",{"class":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500","aria-hidden":"true"}],["SPAN",{},["SPAN",{},"Technical information needed to run and secure the website, such as session data, browser/device information, and basic logs."]]]]],["SECTION",{"class":"rounded-[28px] border border-violet-100/90 bg-white/88 p-5 shadow-[0_24px_70px_-50px_rgba(89,23,196,0.35)] sm:p-7"},["H2",{"class":"text-xl font-black tracking-[-0.025em] text-ink-950 sm:text-2xl"},"3. Payment information"],["DIV",{"class":"mt-4 space-y-3 text-[14px] leading-8 text-ink-700/82 sm:text-[15px] sm:leading-8"},["P",{},["SPAN",{},"Eventies does not currently process online payments through the website. The website is used to submit requests, quote inquiries, and booking details for review. If deposits or payments are arranged outside the website, the payment method and related terms will be communicated separately by Eventies."]]]],["SECTION",{"class":"rounded-[28px] border border-violet-100/90 bg-white/88 p-5 shadow-[0_24px_70px_-50px_rgba(89,23,196,0.35)] sm:p-7"},["H2",{"class":"text-xl font-black tracking-[-0.025em] text-ink-950 sm:text-2xl"},"4. How we use information"],["UL",{"class":"mt-4 space-y-3 text-[14px] leading-8 text-ink-700/82 sm:text-[15px] sm:leading-8"},["LI",{"class":"flex gap-3"},["SPAN",{"class":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500","aria-hidden":"true"}],["SPAN",{},["SPAN",{},"Create, manage, and secure user accounts."]]],["LI",{"class":"flex gap-3"},["SPAN",{"class":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500","aria-hidden":"true"}],["SPAN",{},["SPAN",{},"Receive, review, organize, and follow up on rental requests, purchase quote requests, custom build inquiries, and support messages."]]],["LI",{"class":"flex gap-3"},["SPAN",{"class":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500","aria-hidden":"true"}],["SPAN",{},["SPAN",{},"Coordinate with registered vendors and service providers to check availability, pricing, delivery, setup, and logistics."]]],["LI",{"class":"flex gap-3"},["SPAN",{"class":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500","aria-hidden":"true"}],["SPAN",{},["SPAN",{},"Contact you about your request, account, support issue, or important service updates."]]],["LI",{"class":"flex gap-3"},["SPAN",{"class":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500","aria-hidden":"true"}],["SPAN",{},["SPAN",{},"Improve the website experience, fix bugs, prevent misuse, and protect Eventies, users, and vendors."]]],["LI",{"class":"flex gap-3"},["SPAN",{"class":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500","aria-hidden":"true"}],["SPAN",{},["SPAN",{},"Meet legal, accounting, business, and dispute-resolution requirements where applicable."]]]]],["SECTION",{"class":"rounded-[28px] border border-violet-100/90 bg-white/88 p-5 shadow-[0_24px_70px_-50px_rgba(89,23,196,0.35)] sm:p-7"},["H2",{"class":"text-xl font-black tracking-[-0.025em] text-ink-950 sm:text-2xl"},"5. How we share information"],["DIV",{"class":"mt-4 space-y-3 text-[14px] leading-8 text-ink-700/82 sm:text-[15px] sm:leading-8"},["P",{},["SPAN",{},"We do not sell your personal information. We may share information only when needed to operate Eventies, provide services, or comply with requirements."]]],["UL",{"class":"mt-4 space-y-3 text-[14px] leading-8 text-ink-700/82 sm:text-[15px] sm:leading-8"},["LI",{"class":"flex gap-3"},["SPAN",{"class":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500","aria-hidden":"true"}],["SPAN",{},["SPAN",{},"With vendors or service providers when needed to review availability, pricing, execution, delivery, setup, or request requirements."]]],["LI",{"class":"flex gap-3"},["SPAN",{"class":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500","aria-hidden":"true"}],["SPAN",{},["SPAN",{},"With technology providers that help us host, secure, store, or operate the website and related systems."]]],["LI",{"class":"flex gap-3"},["SPAN",{"class":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500","aria-hidden":"true"}],["SPAN",{},["SPAN",{},"With professional advisers, legal authorities, or government bodies when required by law or needed to protect rights, safety, or property."]]]]],["SECTION",{"class":"rounded-[28px] border border-violet-100/90 bg-white/88 p-5 shadow-[0_24px_70px_-50px_rgba(89,23,196,0.35)] sm:p-7"},["H2",{"class":"text-xl font-black tracking-[-0.025em] text-ink-950 sm:text-2xl"},"6. Data retention"],["DIV",{"class":"mt-4 space-y-3 text-[14px] leading-8 text-ink-700/82 sm:text-[15px] sm:leading-8"},["P",{},["SPAN",{},"We keep personal information only for as long as reasonably needed for the purposes described in this policy, including account management, request history, customer support, legal compliance, business records, dispute handling, and security."]]]],["SECTION",{"class":"rounded-[28px] border border-violet-100/90 bg-white/88 p-5 shadow-[0_24px_70px_-50px_rgba(89,23,196,0.35)] sm:p-7"},["H2",{"class":"text-xl font-black tracking-[-0.025em] text-ink-950 sm:text-2xl"},"7. Security"],["DIV",{"class":"mt-4 space-y-3 text-[14px] leading-8 text-ink-700/82 sm:text-[15px] sm:leading-8"},["P",{},["SPAN",{},"We use reasonable technical and organizational measures to protect personal information. No website or online system can be guaranteed to be completely secure, so users should also protect their account login details and notify us about suspicious activity."]]]],["SECTION",{"class":"rounded-[28px] border border-violet-100/90 bg-white/88 p-5 shadow-[0_24px_70px_-50px_rgba(89,23,196,0.35)] sm:p-7"},["H2",{"class":"text-xl font-black tracking-[-0.025em] text-ink-950 sm:text-2xl"},"8. Your choices and rights"],["DIV",{"class":"mt-4 space-y-3 text-[14px] leading-8 text-ink-700/82 sm:text-[15px] sm:leading-8"},["P",{},["SPAN",{},"You may contact Eventies to request that we:"]]],["UL",{"class":"mt-4 space-y-3 text-[14px] leading-8 text-ink-700/82 sm:text-[15px] sm:leading-8"},["LI",{"class":"flex gap-3"},["SPAN",{"class":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500","aria-hidden":"true"}],["SPAN",{},["SPAN",{},"Provide information about personal data we hold about you."]]],["LI",{"class":"flex gap-3"},["SPAN",{"class":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500","aria-hidden":"true"}],["SPAN",{},["SPAN",{},"Correct inaccurate or incomplete information."]]],["LI",{"class":"flex gap-3"},["SPAN",{"class":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500","aria-hidden":"true"}],["SPAN",{},["SPAN",{},"Delete your account or certain personal information where legally and operationally possible."]]],["LI",{"class":"flex gap-3"},["SPAN",{"class":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500","aria-hidden":"true"}],["SPAN",{},["SPAN",{},"Stop using your information for certain optional purposes, where applicable."]]]]],["SECTION",{"class":"rounded-[28px] border border-violet-100/90 bg-white/88 p-5 shadow-[0_24px_70px_-50px_rgba(89,23,196,0.35)] sm:p-7"},["H2",{"class":"text-xl font-black tracking-[-0.025em] text-ink-950 sm:text-2xl"},"9. Age requirement"],["DIV",{"class":"mt-4 space-y-3 text-[14px] leading-8 text-ink-700/82 sm:text-[15px] sm:leading-8"},["P",{},["SPAN",{},"Eventies is intended for users who are at least 18 years old. By using the website or submitting a request, you confirm that you are 18 or older."]]]],["SECTION",{"class":"rounded-[28px] border border-violet-100/90 bg-white/88 p-5 shadow-[0_24px_70px_-50px_rgba(89,23,196,0.35)] sm:p-7"},["H2",{"class":"text-xl font-black tracking-[-0.025em] text-ink-950 sm:text-2xl"},"10. International use and service locations"],["DIV",{"class":"mt-4 space-y-3 text-[14px] leading-8 text-ink-700/82 sm:text-[15px] sm:leading-8"},["P",{},["SPAN",{},"Because Eventies may review requests inside and outside Jordan, and because website systems may use cloud or technology providers, your information may be processed or stored in locations other than your country of residence where permitted by applicable requirements."]]]],["SECTION",{"class":"rounded-[28px] border border-violet-100/90 bg-white/88 p-5 shadow-[0_24px_70px_-50px_rgba(89,23,196,0.35)] sm:p-7"},["H2",{"class":"text-xl font-black tracking-[-0.025em] text-ink-950 sm:text-2xl"},"11. Updates to this policy"],["DIV",{"class":"mt-4 space-y-3 text-[1