{"type":"before","callId":"call@190","startTime":381203.006,"class":"Frame","method":"evaluateExpression","params":{"expression":"toleranceValue => {\n        const root = document.documentElement;\n        const overflowing = Array.from(document.querySelectorAll('body *')).map(element => {\n          const rect = element.getBoundingClientRect();\n          return {\n            tag: element.tagName.toLowerCase(),\n            className: String(element.className || '').slice(0, 160),\n            id: element.id,\n            text: (element.textContent || '').trim().slice(0, 80),\n            left: Math.round(rect.left),\n            right: Math.round(rect.right),\n            width: Math.round(rect.width)\n          };\n        }).filter(item => item.right > root.clientWidth + toleranceValue || item.left < -toleranceValue).slice(0, 8);\n        return {\n          scrollWidth: root.scrollWidth,\n          clientWidth: root.clientWidth,\n          overflowing\n        };\n      }","isFunction":true,"arg":{"value":{"n":2},"handles":[]}},"stepId":"pw:api@131","pageId":"page@fc8aba27a642d8152d086329128e6f18","beforeSnapshot":"before@call@190"}
