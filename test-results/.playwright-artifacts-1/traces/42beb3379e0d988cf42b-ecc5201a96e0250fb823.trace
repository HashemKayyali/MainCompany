t: 38px !important;\n  }\r\n\r\n  .sm\\:\\[\\&\\>button\\]\\:w-auto>button{\n    width: auto;\n  }\n}\r\n\r\n.\\[\\&_\\*\\]\\:pointer-events-none *{\n  pointer-events: none;\n}\r\n\r\n.\\[\\&_a\\]\\:pointer-events-none a{\n  pointer-events: none;\n}\r\n\r\n.\\[\\&_button\\]\\:pointer-events-none button{\n  pointer-events: none;\n}\r\n\r\n.\\[\\&_input\\]\\:pointer-events-none input{\n  pointer-events: none;\n}\r\n\r\n.\\[\\&_select\\]\\:pointer-events-none select{\n  pointer-events: none;\n}\r\n\r\n.\\[\\&_textarea\\]\\:pointer-events-none textarea{\n  pointer-events: none;\n}\r\n"],["STYLE",{},"@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap');\n\n@supports (min-height: 100svh) {\n  .min-h-screen {\n    min-height: 100svh;\n  }\n}\n\n@supports (height: 100dvh) {\n  .h-screen {\n    height: 100dvh;\n  }\n}\n\n@media (max-width: 640px) {\n  html input:not([type='checkbox']):not([type='radio']):not([type='range']):not([type='file']):not([type='color']),\n  html textarea,\n  html select {\n    font-size: 16px !important;\n  }\n\n  .fixed.inset-x-0.bottom-0 {\n    padding-bottom: max(0.75rem, env(safe-area-inset-bottom));\n  }\n}\n\n@media (hover: none), (pointer: coarse) {\n  .glass:hover,\n  .premium-card:hover,\n  .card-surface:hover,\n  .contact-info-card:hover,\n  .hover-lift:hover,\n  .btn-primary:hover,\n  .btn-outline:hover,\n  .btn-danger:hover,\n  .btn-admin-create:hover,\n  .hover\\:-translate-y-0\\.5:hover,\n  .hover\\:-translate-y-1:hover,\n  .hover\\:-translate-y-2:hover,\n  .hover\\:scale-\\[1\\.05\\]:hover,\n  .group:hover .group-hover\\:scale-105,\n  .group:hover .group-hover\\:scale-110 {\n    transform: none !important;\n  }\n}\n\n[data-native-scroll] {\n  overscroll-behavior-x: contain;\r\n  overscroll-behavior-y: auto;\r\n}\n\n/* ── Focus Styles ── */\n\n:focus-visible {\r\n  outline: 2px solid rgba(124, 58, 237, 0.7);\r\n  outline-offset: 3px;\r\n  border-radius: 8px;\r\n}\n\n.auth-social-button:focus,\r\n.auth-social-button:focus-visible,\r\n.auth-social-button:active {\r\n  outline: none !important;\r\n}\n\n.auth-social-button:focus-visible {\r\n  border-color: rgba(124, 58, 237, 0.5);\r\n  box-shadow:\r\n    inset 0 0 0 1px rgba(124, 58, 237, 0.32),\r\n    0 1px 2px rgba(15, 23, 42, 0.06);\r\n}\n\n.nav-search-input,\r\n.nav-search-input:focus,\r\n.nav-search-input:focus-visible {\r\n  border: 0;\r\n  box-shadow: none;\r\n  outline: none !important;\r\n}\n\n/* The search field is allowed to shrink on constrained desktops; long\r\n   placeholders (especially Arabic) must truncate instead of forcing width. */\n\n.nav-search-input {\r\n  text-overflow: ellipsis;\r\n}\n\n.nav-search-input::-moz-placeholder {\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\n\n.nav-search-input::placeholder {\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\n\n/* ── Performance / Reduced Motion ── */\n\n@media (prefers-reduced-motion: reduce) {\r\n  .animate-aurora,\r\n  .animate-orbit { animation: none !important; }\r\n}\n\nhtml.perf-low .animate-aurora,\r\nhtml.perf-low .animate-orbit {\r\n  animation: none !important;\r\n}\n\n.hero-background-surface {\r\n  contain: paint;\r\n  transform: translate3d(0, 0, 0);\r\n  backface-visibility: hidden;\r\n  will-change: opacity, transform;\r\n}\n\n.hero-background-surface canvas,\r\n.hero-background-surface > * {\r\n  transform: translate3d(0, 0, 0);\r\n  backface-visibility: hidden;\r\n}\n\n.eventies-hero-shell {\r\n  min-height: clamp(660px, 78vh, 760px);\r\n}\n\n.hero-title-silver {\r\n  display: block;\r\n  overflow: visible;\r\n  line-height: 1.13;\r\n  padding-block: 0.015em 0.18em;\r\n  margin-block-end: -0.1em;\r\n}\n\n.hero-title-silver * {\r\n  overflow: visible;\r\n}\n\nmain h1.font-display:not(.hero-title-silver) {\r\n  overflow: visible;\r\n  line-height: 1.12;\r\n  padding-bottom: 0.08em;\r\n  margin-bottom: -0.04em;\r\n}\n\n@media (max-width: 1023px) {\r\n  .eventies-hero-shell {\r\n    min-height: auto;\r\n  }\r\n}\n\n/* Custom Builds alternating section backgrounds */\n\n.custom-builds-bg {\r\n  background:\r\n    linear-gradient(135deg, #0b0322 0%, #190453 38%, #2d0b66 66%, #0a0420 100%);\r\n}\n\n.custom-builds-bg::before,\r\n.custom-builds-bg::after {\r\n  content: '';\r\n  position: absolute;\r\n  inset: -18%;\r\n  pointer-events: none;\r\n}\n\n.custom-builds-bg::before {\r\n  opacity: 0.68;\r\n  background-size: 180% 180%;\r\n  animation: cb-energy-drift 18s ease-in-out infinite;\r\n}\n\n.custom-builds-bg::after {\r\n  opacity: 0.32;\r\n  animation: cb-grid-shift 16s linear infinite;\r\n}\n\n.custom-builds-bg--electric::before {\r\n  background:\r\n    linear-gradient(115deg, transparent 0 18%, rgba(255, 255, 255, 0.2) 19%, transparent 21% 47%, rgba(217, 70, 239, 0.28) 49%, transparent 51%),\r\n    linear-gradient(245deg, transparent 0 32%, rgba(124, 58, 237, 0.32) 33%, transparent 35% 72%, rgba(255, 255, 255, 0.14) 74%, transparent 76%);\r\n}\n\n.custom-builds-bg--electric::after {\r\n  background-image:\r\n    linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),\r\n    linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px),\r\n    repeating-linear-gradient(45deg, rgba(217, 70, 239, 0.12) 0 1px, transparent 1px 24px);\r\n  background-size: 54px 54px, 54px 54px, 96px 96px;\r\n}\n\n.custom-builds-bg--waves {\r\n  background:\r\n    linear-gradient(140deg, #f7f4ff 0%, #ffffff 42%, #efe7ff 100%);\r\n}\n\n.custom-builds-bg--waves::before {\r\n  opacity: 0.75;\r\n  background:\r\n    repeating-radial-gradient(ellipse at 18% 22%, rgba(124, 58, 237, 0.14) 0 2px, transparent 2px 28px),\r\n    repeating-radial-gradient(ellipse at 82% 74%, rgba(217, 70, 239, 0.11) 0 2px, transparent 2px 34px);\r\n}\n\n.custom-builds-bg--waves::after {\r\n  opacity: 0.26;\r\n  background:\r\n    linear-gradient(120deg, transparent 0 28%, rgba(124, 58, 237, 0.2) 29%, transparent 31% 62%, rgba(217, 70, 239, 0.16) 64%, transparent 66%),\r\n    linear-gradient(90deg, rgba(124, 58, 237, 0.08) 1px, transparent 1px);\r\n  background-size: 150% 150%, 38px 38px;\r\n}\n\n.custom-builds-bg--deployment {\r\n  background:\r\n    linear-gradient(140deg, #fbf8ff 0%, #ffffff 32%, #f3ebff 66%, #fbf7ff 100%);\r\n}\n\n.custom-builds-bg--deployment::before {\r\n  inset: -26%;\r\n  opacity: 0.92;\r\n  background:\r\n    radial-gradient(ellipse 44% 34% at 18% 18%, rgba(124, 58, 237, 0.24) 0%, transparent 66%),\r\n    radial-gradient(ellipse 46% 36% at 82% 26%, rgba(217, 70, 239, 0.18) 0%, transparent 68%),\r\n    radial-gradient(ellipse 62% 34% at 48% 92%, rgba(168, 85, 247, 0.18) 0%, transparent 68%),\r\n    conic-gradient(from 165deg at 52% 48%, transparent 0deg, rgba(124, 58, 237, 0.08) 58deg, transparent 112deg, rgba(217, 70, 239, 0.07) 190deg, transparent 260deg, rgba(168, 85, 247, 0.08) 318deg, transparent 360deg);\r\n  filter: blur(22px);\r\n  animation: cb-deployment-aurora 24s ease-in-out infinite;\r\n}\n\n.custom-builds-bg--deployment::after {\r\n  inset: -14% -20%;\r\n  opacity: 0.58;\r\n  background:\r\n    radial-gradient(ellipse 120% 24% at 50% 8%, transparent 46%, rgba(124, 58, 237, 0.13) 50%, transparent 62%),\r\n    radial-gradient(ellipse 126% 26% at 48% 48%, transparent 48%, rgba(217, 70, 239, 0.1) 52%, transparent 64%),\r\n    radial-gradient(ellipse 118% 24% at 52% 88%, transparent 46%, rgba(124, 58, 237, 0.1) 51%, transparent 63%);\r\n  animation: cb-deployment-waves 30s ease-in-out infinite;\r\n}\n\n.custom-builds-bg--circuit::before {\r\n  background:\r\n    linear-gradient(90deg, transparent 0 18%, rgba(168, 85, 247, 0.2) 19%, transparent 20% 46%, rgba(217, 70, 239, 0.18) 47%, transparent 48%),\r\n    linear-gradient(0deg, transparent 0 24%, rgba(255, 255, 255, 0.12) 25%, transparent 26% 72%, rgba(124, 58, 237, 0.18) 73%, transparent 74%);\r\n}\n\n.custom-builds-bg--circuit::after {\r\n  background-image:\r\n    linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),\r\n    linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);\r\n  background-size: 46px 46px;\r\n}\n\n.custom-builds-bg--hero {\r\n  background:\r\n    radial-gradient(68% 58% at 53% 21%, rgba(217, 70, 239, 0.56) 0%, rgba(168, 85, 247, 0.26) 34%, transparent 66%),\r\n    radial-gradient(58% 54% at 82% 56%, rgba(168, 85, 247, 0.48) 0%, transparent 64%),\r\n    radial-gradient(64% 58% at 15% 10%, rgba(91, 33, 182, 0.58) 0%, transparent 66%),\r\n    linear-gradient(145deg, #0b0324 0%, #1b0646 38%, #5b16b6 68%, #9d2bd2 100%);\r\n}\n\n.custom-builds-bg--hero::before {\r\n  inset: -20%;\r\n  opacity: 0.54;\r\n  background:\r\n    radial-gradient(ellipse 64% 34% at 22% 18%, rgba(255, 255, 255, 0.18) 0%, transparent 64%),\r\n    radial-gradient(ellipse 58% 38% at 78% 74%, rgba(217, 70, 239, 0.26) 0%, transparent 66%),\r\n    linear-gradient(120deg, transparent 0 30%, rgba(255, 255, 255, 0.16) 31%, transparent 33% 62%, rgba(168, 85, 247, 0.2) 64%, transparent 66%);\r\n  background-size: 140% 140%;\r\n  filter: blur(8px);\r\n  animation: cb-energy-drift 22s ease-in-out infinite;\r\n}\n\n.custom-builds-bg--hero::after {\r\n  inset: -12%;\r\n  opacity: 0.34;\r\n  background:\r\n    radial-gradient(ellipse 130% 26% at 48% 12%, transparent 46%, rgba(255, 255, 255, 0.13) 50%, transparent 60%),\r\n    radial-gradient(ellipse 126% 30% at 52% 66%, transparent 48%, rgba(217, 70, 239, 0.14) 52%, transparent 62%),\r\n    linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px);\r\n  background-size: auto, auto, 54px 54px;\r\n  animation: cb-deployment-waves 28s ease-in-out infinite;\r\n}\n\n@keyframes cb-energy-drift {\r\n  0%, 100% { transform: translate3d(-2%, -1%, 0) rotate(0deg); background-position: 0% 50%; }\r\n  50% { transform: translate3d(2%, 1%, 0) rotate(1deg); background-position: 100% 50%; }\r\n}\n\n@keyframes cb-grid-shift {\r\n  from { transform: translate3d(0, 0, 0); }\r\n  to { transform: translate3d(46px, 46px, 0); }\r\n}\n\n@keyframes cb-deployment-aurora {\r\n  0%, 100% {\r\n    transform: translate3d(-1.8%, -1.2%, 0) scale(1) rotate(0deg);\r\n    background-position: 0% 50%;\r\n  }\r\n  50% {\r\n    transform: translate3d(1.8%, 1.2%, 0) scale(1.045) rotate(1deg);\r\n    background-position: 100% 50%;\r\n  }\r\n}\n\n@keyframes cb-deployment-waves {\r\n  0%, 100% {\r\n    transform: translate3d(-2.4%, -0.6%, 0) scaleY(1);\r\n    opacity: 0.48;\r\n  }\r\n  50% {\r\n    transform: translate3d(2.4%, 0.8%, 0) scaleY(1.08);\r\n    opacity: 0.72;\r\n  }\r\n}\n\n@media (prefers-reduced-motion: reduce) {\r\n  .custom-builds-bg::before,\r\n  .custom-builds-bg::after {\r\n    animation: none !important;\r\n  }\r\n}\n\nhtml.perf-low .custom-builds-bg::before,\r\nhtml.perf-low .custom-builds-bg::after {\r\n  animation: none !important;\r\n}\n\n/* ── Light dot pattern overlay ── */\n\n/* About / Contact alternating story sections */\n\n/* Homepage alternating section bands */\n\n.home-band {\r\n  position: relative;\r\n  overflow: hidden;\r\n  isolation: isolate;\r\n}\n\n.home-band > section {\r\n  position: relative;\r\n  z-index: 1;\r\n}\n\n.home-band--plain {\r\n  background: #ffffff;\r\n}\n\n.home-band--theme {\r\n  background:\r\n    linear-gradient(135deg, #ffffff 0%, #fbf7ff 30%, #f1e8ff 68%, #ffffff 100%);\r\n}\n\n.home-band--theme::before,\r\n.home-band--theme::after {\r\n  content: '';\r\n  position: absolute;\r\n  inset: -18%;\r\n  z-index: 0;\r\n  pointer-events: none;\r\n}\n\n.home-band--theme::before {\r\n  opacity: 0.82;\r\n  background:\r\n    radial-gradient(ellipse 72% 42% at 17% 18%, rgba(124, 58, 237, 0.16) 0%, transparent 64%),\r\n    radial-gradient(ellipse 62% 36% at 82% 28%, rgba(217, 70, 239, 0.12) 0%, transparent 64%),\r\n    radial-gradient(ellipse 80% 40% at 50% 98%, rgba(168, 85, 247, 0.12) 0%, transparent 68%);\r\n  filter: blur(18px);\r\n  animation: home-band-drift 22s ease-in-out infinite;\r\n}\n\n.home-band--theme::after {\r\n  opacity: 0.58;\r\n  background:\r\n    radial-gradient(ellipse 128% 28% at 50% 8%, transparent 46%, rgba(124, 58, 237, 0.10) 50%, transparent 60%),\r\n    radial-gradient(ellipse 128% 28% at 48% 58%, transparent 48%, rgba(217, 70, 239, 0.08) 52%, transparent 62%),\r\n    linear-gradient(90deg, rgba(124, 58, 237, 0.06) 1px, transparent 1px);\r\n  background-size: auto, auto, 44px 44px;\r\n  animation: home-band-wave 28s ease-in-out infinite;\r\n}\n\n@keyframes home-band-drift {\r\n  0%, 100% { transform: translate3d(-1.5%, -1%, 0) scale(1); }\r\n  50% { transform: translate3d(1.5%, 1%, 0) scale(1.04); }\r\n}\n\n@keyframes home-band-wave {\r\n  0%, 100% { transform: translate3d(-2%, 0, 0); opacity: 0.48; }\r\n  50% { transform: translate3d(2%, 1%, 0); opacity: 0.72; }\r\n}\n\n@media (prefers-reduced-motion: reduce) {\r\n  .home-band--theme::before,\r\n  .home-band--theme::after {\r\n    animation: none !important;\r\n  }\r\n}\n\nhtml.perf-low .home-band--theme::before,\r\nhtml.perf-low .home-band--theme::after {\r\n  animation: none !important;\r\n}\n\n.story-section {\r\n  position: relative;\r\n  overflow: hidden;\r\n  isolation: isolate;\r\n  background: linear-gradient(135deg, #ffffff 0%, #f8f3ff 36%, #f0e8ff 68%, #ffffff 100%);\r\n}\n\n.story-section::before,\r\n.story-section::after {\r\n  content: '';\r\n  position: absolute;\r\n  inset: -18%;\r\n  z-index: -1;\r\n  pointer-events: none;\r\n}\n\n.story-section > .site-container-wide {\r\n  position: relative;\r\n  z-index: 1;\r\n}\n\n.story-section--waves::before {\r\n  opacity: 0.9;\r\n  background:\r\n    radial-gradient(ellipse 72% 44% at 18% 20%, rgba(124, 58, 237, 0.18) 0%, transparent 62%),\r\n    radial-gradient(ellipse 64% 38% at 82% 30%, rgba(217, 70, 239, 0.13) 0%, transparent 64%),\r\n    radial-gradient(ellipse 80% 40% at 50% 96%, rgba(168, 85, 247, 0.14) 0%, transparent 66%);\r\n  filter: blur(18px);\r\n  animation: story-aurora-drift 20s ease-in-out infinite;\r\n}\n\n.story-section--waves::after {\r\n  opacity: 0.72;\r\n  background:\r\n    radial-gradient(ellipse 120% 28% at 50% 3%, transparent 46%, rgba(124, 58, 237, 0.12) 49%, transparent 58%),\r\n    radial-gradient(ellipse 120% 30% at 48% 50%, transparent 48%, rgba(217, 70, 239, 0.09) 51%, transparent 60%),\r\n    radial-gradient(ellipse 120% 28% at 52% 96%, transparent 48%, rgba(124, 58, 237, 0.1) 51%, transparent 60%);\r\n  animation: story-soft-wave 24s ease-in-out infinite;\r\n}\n\n.story-section--ribbons {\r\n  background: linear-gradient(135deg, #ffffff 0%, #fbf7ff 36%, #f1e8ff 72%, #ffffff 100%);\r\n}\n\n.story-section--ribbons::before {\r\n  opacity: 0.84;\r\n  background:\r\n    radial-gradient(ellipse 72% 34% at 18% 10%, rgba(217, 70, 239, 0.13) 0%, transparent 66%),\r\n    radial-gradient(ellipse 74% 38% at 76% 70%, rgba(124, 58, 237, 0.16) 0%, transparent 68%),\r\n    radial-gradient(ellipse 56% 32% at 52% 42%, rgba(168, 85, 247, 0.12) 0%, transparent 70%);\r\n  filter: blur(16px);\r\n  animation: story-aurora-drift 22s ease-in-out infinite reverse;\r\n}\n\n.story-section--ribbons::after {\r\n  opacity: 0.64;\r\n  background:\r\n    radial-gradient(ellipse 135% 26% at 50% 18%, transparent 45%, rgba(124, 58, 237, 0.11) 49%, transparent 58%),\r\n    radial-gradient(ellipse 135% 28% at 50% 72%, transparent 46%, rgba(217, 70, 239, 0.09) 50%, transparent 60%);\r\n  animation: story-soft-wave 26s ease-in-out infinite reverse;\r\n}\n\n.story-section--signals {\r\n  background: linear-gradient(135deg, #ffffff 0%, #f7f1ff 44%, #efe7ff 74%, #ffffff 100%);\r\n}\n\n.story-section--signals::before {\r\n  opacity: 0.82;\r\n  background:\r\n    radial-gradient(ellipse 76% 42% at 20% 78%, rgba(124, 58, 237, 0.15) 0%, transparent 64%),\r\n    radial-gradient(ellipse 62% 36% at 78% 20%, rgba(217, 70, 239, 0.12) 0%, transparent 64%),\r\n    radial-gradient(ellipse 68% 34% at 52% 48%, rgba(168, 85, 247, 0.1) 0%, transparent 68%);\r\n  filter: blur(18px);\r\n  animation: story-aurora-drift 24s ease-in-out infinite;\r\n}\n\n.story-section--signals::after {\r\n  opacity: 0.62;\r\n  background:\r\n    radial-gradient(ellipse 125% 28% at 52% 28%, transparent 46%, rgba(124, 58, 237, 0.1) 50%, transparent 60%),\r\n    radial-gradient(ellipse 125% 28% at 48% 76%, transparent 48%, rgba(217, 70, 239, 0.08) 52%, transparent 62%);\r\n  animation: story-soft-wave 28s ease-in-out infinite;\r\n}\n\n@keyframes story-aurora-drift {\r\n  0%, 100% { transform: translate3d(-1.5%, -1%, 0) scale(1); }\r\n  50% { transform: translate3d(1.5%, 1%, 0) scale(1.04); }\r\n}\n\n@keyframes story-soft-wave {\r\n  0%, 100% { transform: translate3d(-2%, 0, 0) scaleY(1); opacity: 0.56; }\r\n  50% { transform: translate3d(2%, 1%, 0) scaleY(1.08); opacity: 0.78; }\r\n}\n\n/* About / Contact hero symbol systems */\n\n.hero-symbol-stage {\r\n  min-height: clamp(22rem, 42vw, 34rem);\r\n}\n\n.hero-orbit-spin {\r\n  animation: hero-symbol-spin 34s linear infinite;\r\n}\n\n.hero-orbit-spin-reverse {\r\n  animation: hero-symbol-spin 42s linear infinite reverse;\r\n}\n\n.hero-signal-dash {\r\n  stroke-dasharray: 12 14;\r\n  animation: hero-signal-dash 12s linear infinite;\r\n}\n\n.hero-signal-dash--slow {\r\n  animation-duration: 16s;\r\n}\n\n.hero-signal-node {\r\n  animation: hero-node-float 7.5s ease-in-out infinite;\r\n}\n\n.hero-center-pulse {\r\n  animation: hero-center-pulse 3.8s ease-in-out infinite;\r\n}\n\n.hero-flow-dot {\r\n  animation: hero-flow-dot 5.2s ease-in-out infinite;\r\n}\n\n.hero-flow-dot--late {\r\n  animation-delay: 1.7s;\r\n}\n\n@keyframes hero-symbol-spin {\r\n  from { transform: rotate(0deg); }\r\n  to { transform: rotate(360deg); }\r\n}\n\n@keyframes hero-signal-dash {\r\n  from { stroke-dashoffset: 0; }\r\n  to { stroke-dashoffset: -120; }\r\n}\n\n@keyframes hero-node-float {\r\n  0%, 100% { translate: 0 0; scale: 1; }\r\n  50% { translate: 0 -8px; scale: 1.03; }\r\n}\n\n@keyframes hero-center-pulse {\r\n  0%, 100% { opacity: 0.25; transform: scale(0.9); }\r\n  50% { opacity: 0.5; transform: scale(1.08); }\r\n}\n\n@keyframes hero-flow-dot {\r\n  0%, 100% { opacity: 0.45; transform: translate3d(0, 0, 0) scale(0.9); }\r\n  50% { opacity: 1; transform: translate3d(18px, -12px, 0) scale(1.18); }\r\n}\n\n@media (prefers-reduced-motion: reduce) {\r\n  .story-section::before,\r\n  .story-section::after,\r\n  .hero-orbit-spin,\r\n  .hero-orbit-spin-reverse,\r\n  .hero-signal-dash,\r\n  .hero-signal-node,\r\n  .hero-center-pulse,\r\n  .hero-flow-dot {\r\n    animation: none !important;\r\n  }\r\n}\n\nhtml.perf-low .story-section::before,\r\nhtml.perf-low .story-section::after,\r\nhtml.perf-low .hero-orbit-spin,\r\nhtml.perf-low .hero-orbit-spin-reverse,\r\nhtml.perf-low .hero-signal-dash,\r\nhtml.perf-low .hero-signal-node,\r\nhtml.perf-low .hero-center-pulse,\r\nhtml.perf-low .hero-flow-dot {\r\n  animation: none !important;\r\n}\n\n/* Light dot pattern overlay */\n\n.dot-pattern {\r\n  background-image: radial-gradient(rgba(124, 58, 237, 0.10) 1px, transparent 1px);\r\n  background-size: 24px 24px;\r\n}\n\n/* ── Scrollbar hide utility ── */\n\n.scrollbar-hide {\r\n  -ms-overflow-style: none;\r\n  scrollbar-width: none;\r\n}\n\n.scrollbar-hide::-webkit-scrollbar {\r\n  display: none;\r\n}\n\n/* ── Premium transition durations ── */\n\n.transition-350 {\r\n  transition-duration: 350ms;\r\n}\n\n/* ── Premium image rendering ── */\n\nimg {\r\n  image-rendering: -webkit-optimize-contrast;\r\n}\n\n/* ── Selection ── */\n\n::-moz-selection {\r\n  background: rgba(124, 58, 237, 0.22);\r\n  color: #3b0e7c;\r\n}\n\n::selection {\r\n  background: rgba(124, 58, 237, 0.22);\r\n  color: #3b0e7c;\r\n}\n\n/* ── Smooth card elevation on hover ── */\n\n.card-hover {\r\n  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);\r\n}\n\n/* ── Product gallery thumbnail hover ── */\n\n.gallery-thumb-active {\r\n  box-shadow: 0 0 0 2px rgba(124, 58, 237, 0.7);\r\n}\n\n/* ── Typography refinements for long-form content ── */\n\n.prose-detail p {\r\n  line-height: 1.72;\r\n  letter-spacing: -0.01em;\r\n}\n\n/* ── Admin sidebar transitions ── */\n\n.sidebar-link-transition {\r\n  transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;\r\n}\n\n/* Shared media reveal */\n\nimg.framed-image {\r\n  backface-visibility: hidden;\r\n}\n\nimg.framed-image--pending.framed-image--reveal-soft {\r\n  filter: blur(12px) saturate(0.92);\r\n}\n\nimg.framed-image--revealed.framed-image--reveal-soft {\r\n  animation: framed-image-clarify 360ms cubic-bezier(0.16, 1, 0.3, 1);\r\n}\n\nimg.framed-image--reveal-crisp {\r\n  transition: opacity 120ms cubic-bezier(0.16, 1, 0.3, 1);\r\n}\n\nimg.framed-image--pending.framed-image--reveal-crisp {\r\n  opacity: 0.94;\r\n  filter: none;\r\n}\n\nimg.framed-image--revealed.framed-image--reveal-crisp {\r\n  opacity: 1;\r\n  filter: none;\r\n}\n\n@keyframes framed-image-clarify {\r\n  from { filter: blur(12px) saturate(0.92); }\r\n  to { filter: blur(0) saturate(1); }\r\n}\n\n/* ── Hero background orb pulses (CSS-driven, light/violet) ── */\n\n@keyframes hero-orb-violet {\r\n  0%, 100% { opacity: 0.32; transform: scale(1); }\r\n  50% { opacity: 0.55; transform: scale(1.07); }\r\n}\n\n@keyframes hero-orb-pink {\r\n  0%, 100% { opacity: 0.20; transform: scale(1); }\r\n  50% { opacity: 0.36; transform: scale(1.09); }\r\n}\n\n@keyframes hero-orb-light {\r\n  0%, 100% { opacity: 0.16; transform: scale(1); }\r\n  50% { opacity: 0.30; transform: scale(1.06); }\r\n}\n\n.animate-hero-orb-violet {\r\n  animation: hero-orb-violet 9s ease-in-out infinite;\r\n}\n\n.animate-hero-orb-cyan {\r\n  /* alias preserved for legacy refs; now light pink */\r\n  animation: hero-orb-pink 11s ease-in-out 2.5s infinite;\r\n}\n\n.animate-hero-orb-pink {\r\n  animation: hero-orb-light 13s ease-in-out 5s infinite;\r\n}\n\n/* ── Hero floating card animations ── */\n\n@keyframes hero-float-up {\r\n  0%, 100% { transform: translateY(0); }\r\n  50% { transform: translateY(-10px); }\r\n}\n\n@keyframes hero-float-down {\r\n  0%, 100% { transform: translateY(0); }\r\n  50% { transform: translateY(9px); }\r\n}\n\n@keyframes hero-float-up-sm {\r\n  0%, 100% { transform: translateY(0); }\r\n  50% { transform: translateY(-7px); }\r\n}\n\n.animate-hero-float-up {\r\n  animation: hero-float-up 7s ease-in-out infinite;\r\n}\n\n.animate-hero-float-down {\r\n  animation: hero-float-down 8.5s ease-in-out 1.5s infinite;\r\n}\n\n.animate-hero-float-up-sm {\r\n  animation: hero-float-up-sm 9.5s ease-in-out 3s infinite;\r\n}\n\n.route-loader-bar {\r\n  animation: route-loader-sweep 1.1s cubic-bezier(0.16, 1, 0.3, 1) infinite;\r\n  transform-origin: left center;\r\n}\n\n@keyframes route-loader-sweep {\r\n  0% { transform: translateX(-100%) scaleX(0.24); opacity: 0.5; }\r\n  45% { transform: translateX(-10%) scaleX(0.72); opacity: 1; }\r\n  100% { transform: translateX(115%) scaleX(0.3); opacity: 0.65; }\r\n}\n\n@media (prefers-reduced-motion: reduce) {\r\n  .route-loader-bar,\r\n  .animate-hero-orb-violet,\r\n  .animate-hero-orb-cyan,\r\n  .animate-hero-orb-pink,\r\n  .animate-hero-float-up,\r\n  .animate-hero-float-down,\r\n  .animate-hero-float-up-sm {\r\n    animation: none;\r\n  }\r\n}\n\n/* ── Spotlight hover glow (purple-tinted) ── */\n\n.spotlight-glow {\r\n  opacity: 0;\r\n  transition: opacity 0.4s ease;\r\n  z-index: 2;\r\n  background: radial-gradient(\r\n    var(--ss, 240px) circle at var(--sx, 50%) var(--sy, 50%),\r\n    var(--sc, rgba(124, 58, 237, 0.13)),\r\n    transparent 70%\r\n  );\r\n}\n\n@media (pointer: coarse) {\r\n  .spotlight-glow { display: none; }\r\n}\n\nhtml.perf-low .spotlight-glow {\r\n  display: none;\r\n}\n\n@media (prefers-reduced-motion: reduce) {\r\n  .spotlight-glow { transition: none; }\r\n}\n\n/* ── Auth characters: idle float ── */\n\n@keyframes ac-float {\r\n  0%, 100% { transform: translateY(0); }\r\n  50% { transform: translateY(-9px); }\r\n}\n\n@media (prefers-reduced-motion: reduce) {\r\n  .ac-float-wrap { animation: none !important; }\r\n}\n\n/* ── Glow pulse (general) ── */\n\n@keyframes glow-pulse-soft {\r\n  0%, 100% { opacity: 0.4; transform: scale(1); }\r\n  50% { opacity: 0.65; transform: scale(1.04); }\r\n}\n\n.animate-glow-pulse-soft {\r\n  animation: glow-pulse-soft 4.5s ease-in-out infinite;\r\n}\n\n/* ── Sparkle particles (replaces dark-mode meteor trails) ── */\n\n.meteor-trail {\r\n  position: absolute;\r\n  pointer-events: none;\r\n  width: 3px;\r\n  height: 3px;\r\n  border-radius: 999px;\r\n  opacity: 0;\r\n  animation-timing-function: ease-out;\r\n  animation-iteration-count: infinite;\r\n  background: radial-gradient(circle, rgba(168, 85, 247, 0.95) 0%, rgba(168, 85, 247, 0.4) 50%, transparent 100%);\r\n  box-shadow: 0 0 12px 3px rgba(168, 85, 247, 0.5);\r\n  animation-name: hs-sparkle-pulse;\r\n}\n\n.meteor-trail--violet {\r\n  background: radial-gradient(circle, rgba(124, 58, 237, 0.95) 0%, rgba(124, 58, 237, 0.4) 50%, transparent 100%);\r\n  box-shadow: 0 0 12px 3px rgba(124, 58, 237, 0.5);\r\n}\n\n.meteor-trail--cyan {\r\n  background: radial-gradient(circle, rgba(217, 70, 239, 0.85) 0%, rgba(217, 70, 239, 0.35) 50%, transparent 100%);\r\n  box-shadow: 0 0 12px 3px rgba(217, 70, 239, 0.45);\r\n}\n\n@keyframes hs-sparkle-pulse {\r\n  0%, 100% { opacity: 0; transform: scale(0.6); }\r\n  50% { opacity: 1; transform: scale(1.25); }\r\n}\n\n@media (prefers-reduced-motion: reduce) {\r\n  .meteor-trail {\r\n    animation: none !important;\r\n    opacity: 0 !important;\r\n  }\r\n}\n\n/* ── Gradient ring accent (for cards, avatars) ── */\n\n.gradient-ring {\r\n  position: relative;\r\n}\n\n.gradient-ring::after {\r\n  content: '';\r\n  position: absolute;\r\n  inset: -1px;\r\n  border-radius: inherit;\r\n  padding: 1px;\r\n  background: linear-gradient(135deg, rgba(124, 58, 237, 0.6), rgba(217, 70, 239, 0.4), rgba(124, 58, 237, 0.6));\r\n  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);\r\n  -webkit-mask-composite: xor;\r\n  mask-composite: exclude;\r\n  pointer-events: none;\r\n}\n\n/* ── Chip pill ── */\n\n.chip-violet {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 5px 12px;\r\n  border-radius: 999px;\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.04em;\r\n  background: linear-gradient(135deg, rgba(124, 58, 237, 0.10), rgba(168, 85, 247, 0.06));\r\n  border: 1px solid rgba(124, 58, 237, 0.20);\r\n  color: #6d28d9;\r\n}\n\n/* ── Gradient divider ── */\n\n.divider-gradient {\r\n  height: 1px;\r\n  background: linear-gradient(90deg, transparent, rgba(124, 58, 237, 0.32), transparent);\r\n}\n\n/* ── Hover lift utility ── */\n\n.hover-lift {\r\n  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);\r\n}\n\n.hover-lift:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 18px 40px -14px rgba(124, 58, 237, 0.22);\r\n}\n\n/* ── Soft purple glow for accent elements ── */\n\n.glow-purple {\r\n  box-shadow:\r\n    0 0 0 1px rgba(124, 58, 237, 0.16),\r\n    0 12px 32px -8px rgba(124, 58, 237, 0.22);\r\n}\n\n.glow-purple-strong {\r\n  box-shadow:\r\n    0 0 0 1px rgba(124, 58, 237, 0.24),\r\n    0 18px 48px -8px rgba(124, 58, 237, 0.34);\r\n}\n\nhtml[dir=\"rtl\"] body {\r\n  direction: rtl;\r\n}\n\nhtml[dir=\"rtl\"] input,\r\nhtml[dir=\"rtl\"] textarea,\r\nhtml[dir=\"rtl\"] select {\r\n  text-align: right;\r\n}\n\nhtml[dir=\"rtl\"] .nav-search-input {\r\n  text-align: right;\r\n}\n\nhtml[dir=\"rtl\"] .text-left {\r\n  text-align: right;\r\n}\n\nhtml[dir=\"rtl\"] .sm\\:text-left {\r\n  text-align: right;\r\n}\n\n/* Keep the Eventies wordmark visually identical in English and Arabic modes.\r\n   Arabic typography rules intentionally replace display fonts globally, but the\r\n   brand logo must keep its Latin wordmark/font and LTR shaping at all times. */\n\n.eventies-logo-wordmark {\r\n  direction: ltr;\r\n  unicode-bidi: isolate;\r\n  font-family: \"Zodiak\", Georgia, \"Times New Roman\", serif !important;\r\n  line-height: 1 !important;\r\n  letter-spacing: -0.045em !important;\r\n  font-synthesis: none;\r\n  -webkit-font-smoothing: antialiased;\r\n  -moz-osx-font-smoothing: grayscale;\r\n  text-rendering: geometricPrecision;\r\n}\n\n.eventies-logo-icon {\r\n  image-rendering: auto !important;\r\n}\n\nhtml[dir=\"rtl\"] .eventies-logo-wordmark,\r\n.nav-shell-ar .eventies-logo-wordmark {\r\n  font-family: \"Zodiak\", Georgia, \"Times New Roman\", serif !important;\r\n  line-height: 1 !important;\r\n  letter-spacing: -0.045em !important;\r\n  direction: ltr;\r\n  unicode-bidi: isolate;\r\n}\n\n/* ── Arabic typography ──\r\n   Font stack strategy: `Alexandria` is loaded from Google Fonts with the Latin\r\n   subset only, so its @font-face has `unicode-range` restricted to Latin\r\n   codepoints. Putting Alexandria FIRST means Latin characters render in\r\n   Alexandria (identical to English mode) while Arabic codepoints naturally fall\r\n   through to IBM Plex Sans Arabic. That way English words embedded in Arabic\r\n   pages (product names from DB, \"JOD\", numbers, etc.) keep the exact same font,\r\n   weight, and metrics as in English mode — no drift. */\n\n:root {\r\n  --eventies-arabic-font: \"Alexandria\", \"IBM Plex Sans Arabic\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\r\n  --eventies-arabic-display-font: \"Zodiak\", \"Alexandria\", \"IBM Plex Sans Arabic\", system-ui, serif;\r\n}\n\nhtml[dir=\"rtl\"] body,\r\nhtml[dir=\"rtl\"] button,\r\nhtml[dir=\"rtl\"] input,\r\nhtml[dir=\"rtl\"] textarea,\r\nhtml[dir=\"rtl\"] select,\r\nhtml[dir=\"rtl\"] .font-sans {\r\n  font-family: var(--eventies-arabic-font) !important;\r\n}\n\nhtml[dir=\"rtl\"] .font-display:not([data-i18n-skip]):not([data-i18n-skip] *) {\r\n  font-family: var(--eventies-arabic-display-font) !important;\r\n}\n\nhtml[dir=\"rtl\"] .nav-search-input::-moz-placeholder {\r\n  font-family: var(--eventies-arabic-font) !important;\r\n}\n\nhtml[dir=\"rtl\"] .nav-search-input::placeholder {\r\n  font-family: var(--eventies-arabic-font) !important;\r\n}\n\n/* Belt-and-braces: any element the i18n bridge marked as LTR (English content\r\n   inside an Arabic page) is force-restored to the English font stack, weight\r\n   inheritance, and default letter-spacing so it renders identically to English\r\n   mode regardless of any RTL rule that landed earlier. */\n\nhtml[dir=\"rtl\"] [dir=\"ltr\"] {\r\n  font-family: \"Alexandria\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\r\n}\n\nhtml[dir=\"rtl\"] [dir=\"ltr\"].font-display,\r\nhtml[dir=\"rtl\"] [dir=\"ltr\"] .font-display,\r\nhtml[dir=\"rtl\"] .font-display [dir=\"ltr\"] {\r\n  font-family: \"Zodiak\", \"Alexandria\", system-ui, serif !important;\r\n}\n\n/* RTL spacing fixes for translated accordion/content rows. */\n\nhtml[dir=\"rtl\"] .pl-16 {\r\n  padding-left: 1rem;\r\n  padding-right: 4rem;\r\n}\n\nhtml[dir=\"rtl\"] .pl-\\[4\\.25rem\\] {\r\n  padding-left: 1rem;\r\n  padding-right: 4.25rem;\r\n}\n\n@media (min-width: 640px) {\r\n  html[dir=\"rtl\"] .sm\\:pl-\\[4\\.25rem\\] {\r\n    padding-left: 1.25rem;\r\n    padding-right: 4.25rem;\r\n  }\r\n}\n\nhtml[dir=\"rtl\"] .group:hover .group-hover\\:translate-x-0\\.5,\r\nhtml[dir=\"rtl\"] .group:hover .group-hover\\:translate-x-1 {\r\n  transform: translateX(-0.125rem);\r\n}\n\n/* RTL icon direction and media-row stability fixes. */\n\nhtml[dir=\"rtl\"] svg.lucide-arrow-right,\r\nhtml[dir=\"rtl\"] svg.lucide-arrow-left,\r\nhtml[dir=\"rtl\"] svg.lucide-chevron-right,\r\nhtml[dir=\"rtl\"] svg.lucide-chevron-left {\r\n  transform: rotate(180deg) !important;\r\n}\n\nhtml[dir=\"rtl\"] .gallery-strip,\r\nhtml[dir=\"rtl\"] .logo-cloud-track,\r\nhtml[dir=\"rtl\"] .logo-cloud-row {\r\n  direction: ltr;\r\n}\n\nhtml[dir=\"rtl\"] .rtl-hide-step-label {\r\n  display: none !important;\r\n}\n\nhtml[dir=\"rtl\"] .rtl-description,\r\nhtml[dir=\"rtl\"] .section-description,\r\nhtml[dir=\"rtl\"] .hero-description {\r\n  line-height: 1.95 !important;\r\n}\n\n/* Keep the top navigation in a stable brand layout while Arabic content remains RTL elsewhere. */\n\n.nav-shell-ar {\r\n  direction: ltr;\r\n}\n\n.nav-shell-ar input[dir=\"rtl\"] {\r\n  text-align: right;\r\n}\n\n.nav-shell-ar .font-display {\r\n  -webkit-font-smoothing: antialiased;\r\n  -moz-osx-font-smoothing: grayscale;\r\n}\n\n/* Final logo lock: keep the brand mark 100% identical in English and Arabic. */\n\n.eventies-logo-lockup,\r\nhtml[dir=\"rtl\"] .eventies-logo-lockup,\r\n.nav-shell-ar .eventies-logo-lockup {\r\n  direction: ltr !important;\r\n  unicode-bidi: isolate !important;\r\n  flex: 0 0 auto !important;\r\n}\n\n.eventies-logo-full,\r\nhtml[dir=\"rtl\"] .eventies-logo-full,\r\n.nav-shell-ar .eventies-logo-full {\r\n  display: block !important;\r\n  -o-object-fit: contain !important;\r\n     object-fit: contain !important;\r\n  image-rendering: auto !important;\r\n  max-width: none !important;\r\n  transform: none !important;\r\n  font-family: initial !important;\r\n}\n\n.eventies-logo-full--hero,\r\n.eventies-logo-icon.eventies-logo-full--hero,\r\nhtml[dir=\"rtl\"] .eventies-logo-full--hero,\r\n.nav-shell-ar .eventies-logo-full--hero {\r\n  filter: brightness(0) invert(1) !important;\r\n}\n\n.eventies-logo-full--original,\r\n.eventies-logo-icon.eventies-logo-full--original,\r\nhtml[dir=\"rtl\"] .eventies-logo-full--original,\r\n.nav-shell-ar .eventies-logo-full--original {\r\n  filter: none !important;\r\n}\n\n/* ── Dynamic (database/user) content: identical typography to English mode ──\r\n   Elements marked data-i18n-skip carry original (often English) database\r\n   content. They must not inherit the Arabic font swap above — English\r\n   product names/descriptions keep the exact same font, weight rendering,\r\n   and tracking as in English mode. Placed last so it wins the ties against\r\n   the html[dir=\"rtl\"] font overrides above. */\n\nhtml[dir='rtl'] [data-i18n-skip],\r\nhtml[dir='rtl'] [data-i18n-skip] * {\r\n  font-family: 'Alexandria', 'IBM Plex Sans Arabic', system-ui, sans-serif !important;\r\n}\n\n/* Content-direction elements also align by their own content direction,\r\n   overriding any inherited RTL alignment (English -> left, Arabic -> right). */\n\nhtml[dir='rtl'] [data-i18n-skip][dir='auto'],\r\nhtml[dir='rtl'] [data-i18n-skip][dir='ltr'] {\r\n  text-align: start;\r\n}\n\n/* ── Natural bidi direction for mixed-language pages ──\r\n   The language bridge marks text blocks from their own first strong character.\r\n   English database content therefore remains LTR inside the Arabic shell while\r\n   Arabic UI copy stays RTL. The isolate keeps punctuation and adjacent badges\r\n   from borrowing the surrounding page direction. */\n\nhtml[dir='rtl'] [data-bidi-managed='true'][dir='ltr'] {\r\n  direction: ltr;\r\n  unicode-bidi: isolate;\r\n}\n\nhtml[dir='rtl'] [data-bidi-managed='true'][dir='rtl'] {\r\n  direction: rtl;\r\n  unicode-bidi: isolate;\r\n}\n\n/* ── Product details mixed-direction contract ──\r\n   Database product content is English by design, while the surrounding UI can\r\n   be Arabic. Direction is explicit instead of being inferred after paint. */\n\n.product-details-page .product-data-ltr {\r\n  direction: ltr !important;\r\n  unicode-bidi: isolate !important;\r\n  text-align: left !important;\r\n}\n\n.product-details-page .product-data-ltr-row {\r\n  direction: ltr !important;\r\n}\n\n.product-details-page [aria-label='Similar services scroll row'],\r\n.product-details-page [data-product-suggestions-track] {\r\n  max-width: 100%;\r\n  overscroll-behavior-x: contain;\r\n  overscroll-behavior-y: auto;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n"],["LINK",{"rel":"dns-prefetch","href":"https://res.cloudinary.com"}],["LINK",{"rel":"preconnect","href":"https://res.cloudinary.com","crossorigin":"anonymous"}],["LINK",{"rel":"dns-prefetch","href":"http://localhost:54321"}],["LINK",{"rel":"preconnect","href":"http://localhost:54321","crossorigin":"anonymous"}]],"\n\n