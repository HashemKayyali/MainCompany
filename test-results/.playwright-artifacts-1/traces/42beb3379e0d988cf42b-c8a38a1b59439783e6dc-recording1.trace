{"type":"before","callId":"call@446","startTime":414207.164,"class":"Route","method":"fulfill","params":{"status":200,"headers":[{"name":"access-control-allow-origin","value":"*"},{"name":"access-control-expose-headers","value":"*"},{"name":"content-type","value":"application/json"},{"name":"content-length","value":"6259"}],"body":"[{\"id\":\"product-1\",\"title\":\"Bike Blender\",\"slug\":\"bike-blender\",\"description\":\"An interactive healthy experience where participants make their own fresh smoothies by pedaling. The faster you pedal, the faster it blends!\",\"price\":250,\"category_id\":\"cat-bikeland\",\"is_active\":true,\"badge\":\"Most Popular\",\"badge_color\":\"from-amber-400 to-orange-500\",\"category_tags\":[\"Interactive\",\"Wellness\"],\"short_description\":\"Pedal-powered smoothie station. Ride the bike, blend your own fresh drink live.\",\"featured\":true,\"hero_image\":\"/assets/products/bike-blender/hero.webp\",\"gallery\":[\"/assets/products/bike-blender/hero.webp\"],\"quick_options\":[{\"label\":\"Bikes\",\"values\":[\"1\",\"2\",\"3\",\"4\"]}],\"notes\":[\"Requires fresh ingredients\",\"Needs 1x power outlet per bike\",\"Setup: ~30 min\"],\"features_left\":[\"Real blending by cycling\",\"Fresh healthy smoothies\",\"Branded booth & cups\"],\"features_right\":[\"On-site staff included\",\"Perfect for wellness events\",\"Hygiene-first prep\"],\"currency\":\"JOD\",\"show_price\":true,\"video_url\":null,\"rental_enabled\":true,\"sale_enabled\":true,\"stock_total\":4,\"stock_active\":0,\"minimum_rental_days\":1,\"buffer_before_days\":0,\"buffer_after_days\":0,\"created_at\":\"2026-07-10T12:00:00.000Z\"},{\"id\":\"product-2\",\"title\":\"Bike Tower\",\"slug\":\"bike-tower\",\"description\":\"A thrilling two-player race! Each rider powers up their LED Tower. First to the top wins.\",\"price\":350,\"category_id\":\"cat-bikeland\",\"is_active\":true,\"badge\":\"Competitive\",\"badge_color\":\"from-prism-cyan to-blue-500\",\"category_tags\":[\"Competitive\",\"LED\"],\"short_description\":\"Two-player LED tower race. Pedal to light up your tower first.\",\"featured\":true,\"hero_image\":\"/assets/products/bike-tower/hero.webp\",\"gallery\":[\"/assets/products/bike-tower/hero.webp\"],\"quick_options\":[{\"label\":\"Bikes\",\"values\":[\"2\"]}],\"notes\":[\"Works in bright venues\",\"Requires 1x outlet\",\"Setup: ~45 min\"],\"features_left\":[\"Head-to-head competition\",\"Custom LED columns\",\"Fast setup\"],\"features_right\":[\"3 difficulty levels\",\"High impact\",\"Real-time progress\"],\"currency\":\"JOD\",\"show_price\":true,\"video_url\":null,\"rental_enabled\":true,\"sale_enabled\":true,\"stock_total\":4,\"stock_active\":0,\"minimum_rental_days\":1,\"buffer_before_days\":0,\"buffer_after_days\":0,\"created_at\":\"2026-07-10T12:00:00.000Z\"},{\"id\":\"product-3\",\"title\":\"Bike VR\",\"slug\":\"bike-vr\",\"description\":\"Immersive VR cycling combining exercise with digital adventure. Resistance syncs with the virtual world.\",\"price\":400,\"category_id\":\"cat-terminal-vr\",\"is_active\":true,\"badge\":\"Immersive\",\"badge_color\":\"from-prism-pink to-rose-500\",\"category_tags\":[\"Immersive\",\"VR\"],\"short_description\":\"VR cycling through stunning digital worlds.\",\"featured\":true,\"hero_image\":\"/assets/products/bike-vr/hero.webp\",\"gallery\":[\"/assets/products/bike-vr/hero.webp\"],\"quick_options\":[{\"label\":\"Bikes\",\"values\":[\"1\",\"2\"]}],\"notes\":[\"Requires 2x outlets\",\"Age 10+\",\"Staff provided\"],\"features_left\":[\"Full VR immersion\",\"Multiple environments\",\"Synced resistance\"],\"features_right\":[\"Professionally supervised\",\"Perfect for tech events\",\"Unforgettable experience\"],\"currency\":\"JOD\",\"show_price\":true,\"video_url\":null,\"rental_enabled\":true,\"sale_enabled\":true,\"stock_total\":4,\"stock_active\":0,\"minimum_rental_days\":1,\"buffer_before_days\":0,\"buffer_after_days\":0,\"created_at\":\"2026-07-10T12:00:00.000Z\"},{\"id\":\"product-4\",\"title\