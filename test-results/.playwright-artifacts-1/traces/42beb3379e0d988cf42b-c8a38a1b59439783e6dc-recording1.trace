-color\\2c box-shadow\\2c transform\\]{\n  transition-property: border-color,box-shadow,transform;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\r\n\r\n.transition-\\[border-color\\2c box-shadow\\]{\n  transition-property: border-color,box-shadow;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\r\n\r\n.transition-\\[filter\\]{\n  transition-property: filter;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\r\n\r\n.transition-\\[flex\\2c opacity\\2c transform\\2c box-shadow\\2c height\\]{\n  transition-property: flex,opacity,transform,box-shadow,height;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\r\n\r\n.transition-\\[grid-template-columns\\]{\n  transition-property: grid-template-columns;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\r\n\r\n.transition-\\[top\\]{\n  transition-property: top;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\r\n\r\n.transition-\\[transform\\2c box-shadow\\2c background-color\\2c opacity\\]{\n  transition-property: transform,box-shadow,background-color,opacity;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\r\n\r\n.transition-all{\n  transition-property: all;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\r\n\r\n.transition-colors{\n  transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\r\n\r\n.transition-none{\n  transition-property: none;\n}\r\n\r\n.transition-opacity{\n  transition-property: opacity;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\r\n\r\n.transition-shadow{\n  transition-property: box-shadow;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\r\n\r\n.transition-transform{\n  transition-property: transform;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\r\n\r\n.duration-0{\n  transition-duration: 0s;\n}\r\n\r\n.duration-150{\n  transition-duration: 150ms;\n}\r\n\r\n.duration-200{\n  transition-duration: 200ms;\n}\r\n\r\n.duration-300{\n  transition-duration: 300ms;\n}\r\n\r\n.duration-350{\n  transition-duration: 350ms;\n}\r\n\r\n.duration-400{\n  transition-duration: 400ms;\n}\r\n\r\n.duration-500{\n  transition-duration: 500ms;\n}\r\n\r\n.duration-700{\n  transition-duration: 700ms;\n}\r\n\r\n.ease-\\[cubic-bezier\\(0\\.16\\2c 1\\2c 0\\.3\\2c 1\\)\\]{\n  transition-timing-function: cubic-bezier(0.16,1,0.3,1);\n}\r\n\r\n.ease-in{\n  transition-timing-function: cubic-bezier(0.4, 0, 1, 1);\n}\r\n\r\n.ease-in-out{\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n}\r\n\r\n.ease-out{\n  transition-timing-function: cubic-bezier(0, 0, 0.2, 1);\n}\r\n\r\n.will-change-transform{\n  will-change: transform;\n}\r\n\r\n.\\[-webkit-box-orient\\:vertical\\]{\n  -webkit-box-orient: vertical;\n}\r\n\r\n.\\[-webkit-line-clamp\\:1\\]{\n  -webkit-line-clamp: 1;\n}\r\n\r\n.\\[-webkit-line-clamp\\:2\\]{\n  -webkit-line-clamp: 2;\n}\r\n\r\n.\\[-webkit-overflow-scrolling\\:touch\\]{\n  -webkit-overflow-scrolling: touch;\n}\r\n\r\n.\\[appearance\\:textfield\\]{\n  -webkit-appearance: textfield;\n     -moz-appearance: textfield;\n          appearance: textfield;\n}\r\n\r\n.\\[backface-visibility\\:hidden\\]{\n  backface-visibility: hidden;\n}\r\n\r\n.\\[display\\:-webkit-box\\]{\n  display: -webkit-box;\n}\r\n\r\n.\\[perspective\\:1400px\\]{\n  perspective: 1400px;\n}\r\n\r\n.\\[scroll-behavior\\:auto\\]{\n  scroll-behavior: auto;\n}\r\n\r\n.\\[scrollbar-color\\:rgba\\(124\\2c 58\\2c 237\\2c 0\\.35\\)_transparent\\]{\n  scrollbar-color: rgba(124,58,237,0.35) transparent;\n}\r\n\r\n.\\[scrollbar-color\\:rgba\\(124\\2c 58\\2c 237\\2c 0\\.50\\)_rgba\\(226\\2c 232\\2c 240\\2c 0\\.95\\)\\]{\n  scrollbar-color: rgba(124,58,237,0.50) rgba(226,232,240,0.95);\n}\r\n\r\n.\\[scrollbar-color\\:rgba\\(167\\2c 139\\2c 250\\2c 0\\.55\\)_rgba\\(255\\2c 255\\2c 255\\2c 0\\.06\\)\\]{\n  scrollbar-color: rgba(167,139,250,0.55) rgba(255,255,255,0.06);\n}\r\n\r\n.\\[scrollbar-color\\:rgba\\(240\\2c 171\\2c 252\\2c 0\\.72\\)_rgba\\(255\\2c 255\\2c 255\\2c 0\\.08\\)\\]{\n  scrollbar-color: rgba(240,171,252,0.72) rgba(255,255,255,0.08);\n}\r\n\r\n.\\[scrollbar-gutter\\:stable\\]{\n  scrollbar-gutter: stable;\n}\r\n\r\n.\\[scrollbar-width\\:none\\]{\n  scrollbar-width: none;\n}\r\n\r\n.\\[scrollbar-width\\:thin\\]{\n  scrollbar-width: thin;\n}\r\n\r\n.\\[stroke-dasharray\\:12_63\\]{\n  stroke-dasharray: 12 63;\n}\r\n\r\n.\\[stroke-dasharray\\:20_300\\]{\n  stroke-dasharray: 20 300;\n}\r\n\r\n.\\[stroke-dashoffset\\:-32\\.42px\\]{\n  stroke-dashoffset: -32.42px;\n}\r\n\r\n.\\[transform-style\\:preserve-3d\\]{\n  transform-style: preserve-3d;\n}\r\n\r\n.\\[transform\\:rotateY\\(180deg\\)\\]{\n  transform: rotateY(180deg);\n}\r\n\r\n/* ─────────────────────────────────────────────────────────────────────────\r\n   Light-theme text-contrast overrides\r\n   ─────────────────────────────────────────────────────────────────────────\r\n   The site is locked to a light color-scheme. Tailwind's medium gray /\r\n   slate / zinc / neutral / stone text shades (300–500) look washed-out\r\n   over the lavender background. We remap *only the text utilities* —\r\n   bg-/border-/divide- variants are untouched — to a deep, near-black ink\r\n   scale so primary, secondary, and tertiary copy all read crisply.\r\n\r\n   The `html` prefix lifts specificity above Tailwind's single-class\r\n   utilities so source order does not matter.\r\n   ───────────────────────────────────────────────────────────────────── */\r\n\r\n/* True primary text — push to near-black. */\r\n\r\nhtml .text-gray-900,\r\nhtml .text-gray-950,\r\nhtml .text-slate-900,\r\nhtml .text-slate-950,\r\nhtml .text-zinc-900,\r\nhtml .text-zinc-950,\r\nhtml .text-neutral-900,\r\nhtml .text-neutral-950,\r\nhtml .text-stone-900,\r\nhtml .text-stone-950 {\r\n  color: #07041a;\r\n}\r\n\r\n/* Strong body / heading aliases. */\r\n\r\nhtml .text-gray-800,\r\nhtml .text-gray-700,\r\nhtml .text-slate-800,\r\nhtml .text-slate-700,\r\nhtml .text-zinc-800,\r\nhtml .text-zinc-700,\r\nhtml .text-neutral-800,\r\nhtml .text-neutral-700,\r\nhtml .text-stone-800,\r\nhtml .text-stone-700 {\r\n  color: #110725;\r\n}\r\n\r\n/* Mid grays — the worst offenders for \"washed out\" copy.\r\n   Bumped to deep ink for prices, labels, product names, descriptions. */\r\n\r\nhtml .text-gray-600,\r\nhtml .text-slate-600,\r\nhtml .text-zinc-600,\r\nhtml .text-neutral-600,\r\nhtml .text-stone-600 {\r\n  color: #1a0d3a;\r\n}\r\n\r\nhtml .text-gray-500,\r\nhtml .text-slate-500,\r\nhtml .text-zinc-500,\r\nhtml .text-neutral-500,\r\nhtml .text-stone-500 {\r\n  color: #211049;\r\n}\r\n\r\nhtml .text-gray-400,\r\nhtml .text-slate-400,\r\nhtml .text-zinc-400,\r\nhtml .text-neutral-400,\r\nhtml .text-stone-400 {\r\n  color: #31195f;\r\n}\r\n\r\nhtml .text-gray-300,\r\nhtml .text-slate-300,\r\nhtml .text-zinc-300,\r\nhtml .text-neutral-300,\r\nhtml .text-stone-300 {\r\n  color: #4a2c8f;\r\n}\r\n\r\n/* Hover variants — keep readable when nudged darker. */\r\n\r\nhtml .hover\\:text-gray-900:hover,\r\nhtml .hover\\:text-slate-900:hover,\r\nhtml .hover\\:text-zinc-900:hover,\r\nhtml .hover\\:text-neutral-900:hover,\r\nhtml .hover\\:text-stone-900:hover {\r\n  color: #07041a;\r\n}\r\n\r\nhtml .hover\\:text-gray-700:hover,\r\nhtml .hover\\:text-slate-700:hover,\r\nhtml .hover\\:text-zinc-700:hover,\r\nhtml .hover\\:text-neutral-700:hover,\r\nhtml .hover\\:text-stone-700:hover {\r\n  color: #110725;\r\n}\r\n\r\n/* Placeholders site-wide: stronger than the original 0.4 alpha defaults. */\r\n\r\nhtml input::-moz-placeholder, html textarea::-moz-placeholder, html select::-moz-placeholder {\r\n  color: rgba(33, 16, 73, 0.62);\r\n}\r\n\r\nhtml input::placeholder,\r\nhtml textarea::placeholder,\r\nhtml select::placeholder {\r\n  color: rgba(33, 16, 73, 0.62);\r\n}\r\n\r\n/* Native date / time pickers — make their value text crisp. */\r\n\r\nhtml input[type='date'],\r\nhtml input[type='time'],\r\nhtml input[type='datetime-local'],\r\nhtml input[type='month'],\r\nhtml input[type='week'] {\r\n  color: #07041a;\r\n  font-weight: 600;\r\n}\r\n\r\nhtml input[type='date']::-webkit-datetime-edit,\r\nhtml input[type='time']::-webkit-datetime-edit,\r\nhtml input[type='datetime-local']::-webkit-datetime-edit {\r\n  color: #07041a;\r\n}\r\n\r\nhtml input[type='date']::-webkit-datetime-edit-text,\r\nhtml input[type='time']::-webkit-datetime-edit-text {\r\n  color: #211049;\r\n  padding: 0 2px;\r\n}\r\n\r\n/* Disabled inputs — still readable instead of ghostly. */\r\n\r\nhtml .form-field:disabled,\r\nhtml input:disabled,\r\nhtml textarea:disabled,\r\nhtml select:disabled {\r\n  color: #31195f;\r\n  -webkit-text-fill-color: #31195f;\r\n}\r\n\r\n/* ─────────────────────────────────────────────────────────────────────────\r\n   Admin shell: cohesive violet surface language\r\n   ─────────────────────────────────────────────────────────────────────────\r\n   The admin pages were authored dark-mode-first; their light branch leans\r\n   on weak neutral grays (ring/border-gray-*) that read washed-out and\r\n   inconsistent next to the refreshed violet/ink design system. Scoped to\r\n   `.admin-scope` (the admin <main> wrapper) we gently retone ONLY the\r\n   neutral ring/border utilities to the brand violet — fills, status\r\n   colours (red/amber/emerald) and text are left untouched. The\r\n   double-class selector outranks Tailwind's single-class utilities, so\r\n   no per-page edits are required and nothing leaks outside admin.\r\n   ───────────────────────────────────────────────────────────────────── */\r\n\r\n.admin-scope .ring-gray-200,\r\n.admin-scope .hover\\:ring-gray-300:hover {\r\n  --tw-ring-color: rgba(113, 38, 227, 0.20);\r\n}\r\n\r\n.admin-scope .ring-gray-200 {\r\n  --tw-ring-color: rgba(113, 38, 227, 0.18);\r\n}\r\n\r\n.admin-scope .border-gray-200 {\r\n  border-color: rgba(113, 38, 227, 0.18);\r\n}\r\n\r\n.admin-scope .border-gray-100 {\r\n  border-color: rgba(113, 38, 227, 0.10);\r\n}\r\n\r\n.admin-scope .divide-gray-100 > :not([hidden]) ~ :not([hidden]) {\r\n  border-color: rgba(113, 38, 227, 0.10);\r\n}\r\n\r\n/* Soft neutral panel fills → a barely-there lavender so cards/sections\r\n   sit on a coherent tint instead of flat cool gray. Kept very light to\r\n   preserve text contrast. */\r\n\r\n.admin-scope .bg-gray-50,\r\n.admin-scope .bg-gray-50\\/70,\r\n.admin-scope .bg-gray-50\\/80,\r\n.admin-scope .bg-gray-50\\/90 {\r\n  background-color: rgba(247, 241, 255, 0.85);\r\n}\r\n\r\n/* Slightly stronger neutral fill (toggle tracks, inset wells). */\r\n\r\n.admin-scope .bg-gray-100 {\r\n  background-color: rgba(236, 220, 255, 0.7);\r\n}\r\n\r\n/* Stronger neutral border / ring variants used by inputs & toggles. */\r\n\r\n.admin-scope .border-gray-300,\r\n.admin-scope .hover\\:border-gray-300:hover {\r\n  border-color: rgba(113, 38, 227, 0.30);\r\n}\r\n\r\n.admin-scope .ring-gray-300 {\r\n  --tw-ring-color: rgba(113, 38, 227, 0.30);\r\n}\r\n\r\n.admin-scope .divide-gray-200 > :not([hidden]) ~ :not([hidden]) {\r\n  border-color: rgba(113, 38, 227, 0.16);\r\n}\r\n\r\n.placeholder\\:text-xs::-moz-placeholder{\n  font-size: 0.75rem;\n  line-height: 1rem;\n}\r\n\r\n.placeholder\\:text-xs::placeholder{\n  font-size: 0.75rem;\n  line-height: 1rem;\n}\r\n\r\n.placeholder\\:\\!text-ink-400\\/70::-moz-placeholder{\n  color: rgb(140 112 207 / 0.7) !important;\n}\r\n\r\n.placeholder\\:\\!text-ink-400\\/70::placeholder{\n  color: rgb(140 112 207 / 0.7) !important;\n}\r\n\r\n.placeholder\\:\\!text-purple-100\\/\\[0\\.45\\]::-moz-placeholder{\n  color: rgb(243 232 255 / 0.45) !important;\n}\r\n\r\n.placeholder\\:\\!text-purple-100\\/\\[0\\.45\\]::placeholder{\n  color: rgb(243 232 255 / 0.45) !important;\n}\r\n\r\n.placeholder\\:text-\\[\\#8a789f\\]::-moz-placeholder{\n  --tw-text-opacity: 1;\n  color: rgb(138 120 159 / var(--tw-text-opacity, 1));\n}\r\n\r\n.placeholder\\:text-\\[\\#8a789f\\]::placeholder{\n  --tw-text-opacity: 1;\n  color: rgb(138 120 159 / var(--tw-text-opacity, 1));\n}\r\n\r\n.placeholder\\:text-\\[var\\(--admin-text-muted\\)\\]::-moz-placeholder{\n  color: var(--admin-text-muted);\n}\r\n\r\n.placeholder\\:text-\\[var\\(--admin-text-muted\\)\\]::placeholder{\n  color: var(--admin-text-muted);\n}\r\n\r\n.placeholder\\:text-gray-400::-moz-placeholder{\n  --tw-text-opacity: 1;\n  color: rgb(156 163 175 / var(--tw-text-opacity, 1));\n}\r\n\r\n.placeholder\\:text-gray-400::placeholder{\n  --tw-text-opacity: 1;\n  color: rgb(156 163 175 / var(--tw-text-opacity, 1));\n}\r\n\r\n.placeholder\\:text-ink-400::-moz-placeholder{\n  --tw-text-opacity: 1;\n  color: rgb(140 112 207 / var(--tw-text-opacity, 1));\n}\r\n\r\n.placeholder\\:text-ink-400::placeholder{\n  --tw-text-opacity: 1;\n  color: rgb(140 112 207 / var(--tw-text-opacity, 1));\n}\r\n\r\n.placeholder\\:text-slate-400\\/70::-moz-placeholder{\n  color: rgb(148 163 184 / 0.7);\n}\r\n\r\n.placeholder\\:text-slate-400\\/70::placeholder{\n  color: rgb(148 163 184 / 0.7);\n}\r\n\r\n.placeholder\\:text-white\\/30::-moz-placeholder{\n  color: rgb(255 255 255 / 0.3);\n}\r\n\r\n.placeholder\\:text-white\\/30::placeholder{\n  color: rgb(255 255 255 / 0.3);\n}\r\n\r\n.before\\:absolute::before{\n  content: var(--tw-content);\n  position: absolute;\n}\r\n\r\n.before\\:bottom-2::before{\n  content: var(--tw-content);\n  bottom: 0.5rem;\n}\r\n\r\n.before\\:left-\\[17px\\]::before{\n  content: var(--tw-content);\n  left: 17px;\n}\r\n\r\n.before\\:left-\\[23px\\]::before{\n  content: var(--tw-content);\n  left: 23px;\n}\r\n\r\n.before\\:start-\\[7px\\]::before{\n  content: var(--tw-content);\n  inset-inline-start: 7px;\n}\r\n\r\n.before\\:top-2::before{\n  content: var(--tw-content);\n  top: 0.5rem;\n}\r\n\r\n.before\\:top-4::before{\n  content: var(--tw-content);\n  top: 1rem;\n}\r\n\r\n.before\\:top-6::before{\n  content: var(--tw-content);\n  top: 1.5rem;\n}\r\n\r\n.before\\:h-\\[calc\\(100\\%-2rem\\)\\]::before{\n  content: var(--tw-content);\n  height: calc(100% - 2rem);\n}\r\n\r\n.before\\:h-\\[calc\\(100\\%-3rem\\)\\]::before{\n  content: var(--tw-content);\n  height: calc(100% - 3rem);\n}\r\n\r\n.before\\:w-\\[2px\\]::before{\n  content: var(--tw-content);\n  width: 2px;\n}\r\n\r\n.before\\:w-px::before{\n  content: var(--tw-content);\n  width: 1px;\n}\r\n\r\n.before\\:rounded-full::before{\n  content: var(--tw-content);\n  border-radius: 9999px;\n}\r\n\r\n.before\\:bg-violet-200::before{\n  content: var(--tw-content);\n  --tw-bg-opacity: 1;\n  background-color: rgb(221 214 254 / var(--tw-bg-opacity, 1));\n}\r\n\r\n.before\\:bg-gradient-to-b::before{\n  content: var(--tw-content);\n  background-image: linear-gradient(to bottom, var(--tw-gradient-stops));\n}\r\n\r\n.before\\:from-violet-200::before{\n  content: var(--tw-content);\n  --tw-gradient-from: #ddd6fe var(--tw-gradient-from-position);\n  --tw-gradient-to: rgb(221 214 254 / 0) var(--tw-gradient-to-position);\n  --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to);\n}\r\n\r\n.before\\:from-violet-300::before{\n  content: var(--tw-content);\n  --tw-gradient-from: #c4b5fd var(--tw-gradient-from-position);\n  --tw-gradient-to: rgb(196 181 253 / 0) var(--tw-gradient-to-position);\n  --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to);\n}\r\n\r\n.before\\:via-fuchsia-300::before{\n  content: var(--tw-content);\n  --tw-gradient-to: rgb(240 171 252 / 0)  var(--tw-gradient-to-position);\n  --tw-gradient-stops: var(--tw-gradient-from), #f0abfc var(--tw-gradient-via-position), var(--tw-gradient-to);\n}\r\n\r\n.before\\:via-violet-100::before{\n  content: var(--tw-content);\n  --tw-gradient-to: rgb(237 233 254 / 0)  var(--tw-gradient-to-position);\n  --tw-gradient-stops: var(--tw-gradient-from), #ede9fe var(--tw-gradient-via-position), var(--tw-gradient-to);\n}\r\n\r\n.before\\:to-transparent::before{\n  content: var(--tw-content);\n  --tw-gradient-to: transparent var(--tw-gradient-to-position);\n}\r\n\r\n.before\\:to-violet-200::before{\n  content: var(--tw-content);\n  --tw-gradient-to: #ddd6fe var(--tw-gradient-to-position);\n}\r\n\r\n.after\\:pointer-events-none::after{\n  content: var(--tw-content);\n  pointer-events: none;\n}\r\n\r\n.after\\:absolute::after{\n  content: var(--tw-content);\n  position: absolute;\n}\r\n\r\n.after\\:inset-x-0::after{\n  content: var(--tw-content);\n  left: 0px;\n  right: 0px;\n}\r\n\r\n.after\\:top-full::after{\n  content: var(--tw-content);\n  top: 100%;\n}\r\n\r\n.after\\:h-2::after{\n  content: var(--tw-content);\n  height: 0.5rem;\n}\r\n\r\n.after\\:bg-gradient-to-b::after{\n  content: var(--tw-content);\n  background-image: linear-gradient(to bottom, var(--tw-gradient-stops));\n}\r\n\r\n.after\\:from-black\\/\\[0\\.07\\]::after{\n  content: var(--tw-content);\n  --tw-gradient-from: rgb(0 0 0 / 0.07) var(--tw-gradient-from-position);\n  --tw-gradient-to: rgb(0 0 0 / 0) var(--tw-gradient-to-position);\n  --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to);\n}\r\n\r\n.after\\:from-black\\/\\[0\\.18\\]::after{\n  content: var(--tw-content);\n  --tw-gradient-from: rgb(0 0 0 / 0.18) var(--tw-gradient-from-position);\n  --tw-gradient-to: rgb(0 0 0 / 0) var(--tw-gradient-to-position);\n  --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to);\n}\r\n\r\n.after\\:to-transparent::after{\n  content: var(--tw-content);\n  --tw-gradient-to: transparent var(--tw-gradient-to-position);\n}\r\n\r\n.first\\:pt-0:first-child{\n  padding-top: 0px;\n}\r\n\r\n.last\\:border-0:last-child{\n  border-width: 0px;\n}\r\n\r\n.last\\:border-b-0:last-c